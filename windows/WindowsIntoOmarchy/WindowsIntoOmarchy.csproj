<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WindowsIntoOmarchy</AssemblyName>
    <RootNamespace>WindowsIntoOmarchy</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\WindowsIntoOmarchy.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <Version>0.3.0</Version>
    <Authors>Windows Into Omarchy contributors</Authors>
    <Description>A frictionless, host-safe Omarchy machine for Windows.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="..\..\assets\WindowsIntoOmarchy.ico" Link="WindowsIntoOmarchy.ico" />
  </ItemGroup>
</Project>
