<Window x:Class="WindowsIntoOnarchy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Into Onarchy" Width="720" Height="610"
        Icon="WindowsIntoOnarchy.ico"
        MinWidth="660" MinHeight="560" WindowStartupLocation="CenterScreen"
        Background="#0B0D0D" Foreground="#F2F1EA" FontFamily="Segoe UI"
        ResizeMode="CanMinimize">
  <Window.Resources>
    <SolidColorBrush x:Key="Panel" Color="#151918"/>
    <SolidColorBrush x:Key="Line" Color="#343A38"/>
    <SolidColorBrush x:Key="Accent" Color="#C9FF36"/>
    <SolidColorBrush x:Key="Muted" Color="#9BA39F"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#202523"/><Setter Property="Foreground" Value="#F2F1EA"/>
      <Setter Property="BorderBrush" Value="#46504C"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="17,10"/><Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="Background" Value="#29302D"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="BorderThickness" Value="2"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="#0B0D0D"/>
      <Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="Padding" Value="24,15"/><Setter Property="FontSize" Value="15"/>
    </Style>
  </Window.Resources>

  <Grid Margin="44,34,44,28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="OM//WIN  03" Foreground="{StaticResource Accent}" FontFamily="Consolas" FontSize="12" FontWeight="Bold"/>
      <TextBlock Text="Windows Into Onarchy" FontSize="34" FontWeight="Light" Margin="0,5,0,0"/>
      <TextBlock Text="A complete Omarchy machine, contained safely inside Windows." Foreground="{StaticResource Muted}" FontSize="14" Margin="1,5,0,0"/>
    </StackPanel>

    <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="3" Margin="0,28,0,22" Padding="30">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="Headline" Text="Checking this PC" FontSize="27" FontWeight="Light" TextAlignment="Center"/>
          <TextBlock x:Name="Detail" Text="This only takes a moment." Foreground="{StaticResource Muted}" FontSize="14" TextWrapping="Wrap" TextAlignment="Center" Margin="20,10,20,0"/>
          <ProgressBar x:Name="Progress" Height="7" Minimum="0" Maximum="100" Value="0" Margin="10,28,10,0" Foreground="{StaticResource Accent}" Background="#2A302E" BorderThickness="0"/>
          <TextBlock x:Name="Phase" Text="CHECKING" Foreground="{StaticResource Muted}" FontFamily="Consolas" FontSize="11" TextAlignment="Center" Margin="10,12,10,0"/>
          <Grid Margin="60,27,60,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" HorizontalAlignment="Center"><Ellipse x:Name="PcDot" Width="8" Height="8" Fill="#68706C"/><TextBlock Text="PC" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0"/></StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Center"><Ellipse x:Name="AccelerationDot" Width="8" Height="8" Fill="#68706C"/><TextBlock Text="ACCELERATION" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0"/></StackPanel>
            <StackPanel Grid.Column="2" HorizontalAlignment="Center"><Ellipse x:Name="EngineDot" Width="8" Height="8" Fill="#68706C"/><TextBlock Text="ENGINE" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0"/></StackPanel>
            <StackPanel Grid.Column="3" HorizontalAlignment="Center"><Ellipse x:Name="OmarchyDot" Width="8" Height="8" Fill="#68706C"/><TextBlock Text="OMARCHY" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0"/></StackPanel>
          </Grid>
        </StackPanel>

        <Button x:Name="Primary" Grid.Row="1" Style="{StaticResource PrimaryButton}" Content="Continue" HorizontalAlignment="Stretch" Margin="0,25,0,0" Click="Primary_Click"/>

        <Expander Grid.Row="2" Header="Recovery and advanced options" Foreground="{StaticResource Muted}" Margin="0,18,0,0">
          <StackPanel Margin="0,13,0,0">
            <TextBlock Text="The guest receives one private virtual disk. Windows drives, folders, and physical devices are never attached." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,12"/>
            <WrapPanel>
              <Button x:Name="Disposable" Content="Disposable session" Click="Disposable_Click"/>
              <Button Content="Open logs" Click="Logs_Click"/><Button Content="Machine files" Click="Files_Click"/>
              <Button x:Name="Reset" Content="Archive &amp; reset" Click="Reset_Click"/>
            </WrapPanel>
            <TextBlock x:Name="Technical" Text="Resources are selected automatically for this PC." Foreground="#707975" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Margin="0,10,0,0"/>
          </StackPanel>
        </Expander>
      </Grid>
    </Border>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="HOST-SAFE BY CONSTRUCTION" Foreground="{StaticResource Accent}" FontFamily="Consolas" FontSize="10" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" Text="LEFT SHIFT + LEFT CTRL + LEFT ALT + G  releases input" Foreground="#707975" FontFamily="Consolas" FontSize="9" VerticalAlignment="Center"/>
    </Grid>
  </Grid>
</Window>
