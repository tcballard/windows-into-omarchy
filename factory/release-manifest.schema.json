{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tcballard/windows-into-omarchy/blob/main/factory/release-manifest.schema.json",
  "title": "Windows Into Onarchy factory release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "product", "productVersion", "releaseTag", "buildId", "architecture", "assets", "upstream"],
  "properties": {
    "schemaVersion": {"const": 1},
    "product": {"const": "Windows Into Onarchy"},
    "productVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "releaseTag": {"type": "string", "pattern": "^factory-v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "buildId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{7,127}$"},
    "architecture": {"const": "x86_64"},
    "assets": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "archive", "outputRelativePath", "assembledSizeBytes", "assembledSha256", "payload", "parts"],
        "properties": {
          "role": {"enum": ["runtime", "guest"]},
          "archive": {"enum": ["zip", "zstd"]},
          "outputRelativePath": {"type": "string", "minLength": 1},
          "assembledSizeBytes": {"type": "integer", "minimum": 1},
          "assembledSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "payload": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "relativePath", "sizeBytes", "sha256"],
            "properties": {
              "kind": {"enum": ["file", "tree-manifest"]},
              "relativePath": {"type": "string", "minLength": 1},
              "sizeBytes": {"type": "integer", "minimum": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          },
          "parts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["index", "fileName", "url", "sizeBytes", "sha256"],
              "properties": {
                "index": {"type": "integer", "minimum": 0},
                "fileName": {"type": "string", "minLength": 1},
                "url": {"type": "string", "pattern": "^https://"},
                "sizeBytes": {"type": "integer", "minimum": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["omarchyCommit", "qemuSourceSha256"],
      "properties": {
        "omarchyCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "qemuSourceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
